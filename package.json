{
  "name": "@benchgen/benchgen-openclaw",
  "version": "0.8.6",
  "description": "Stream OpenClaw agent traces to Benchgen and let Benchgen chat with the agent",
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "cli.js",
    "configure.js",
    "tracer.js",
    "usage.js",
    "mapping.js",
    "transcript.js",
    "chat.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "mirror.js",
    "otel-log.js",
    "private.js"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "runtimeExtensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.1"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    },
    "install": {
      "npmSpec": "@benchgen/benchgen-openclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.1"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "benchgen",
    "observability",
    "llm",
    "tracing",
    "diagnostics",
    "chat",
    "agent-bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benchgen-ai/benchgen-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/benchgen-ai/benchgen-openclaw/issues"
  },
  "homepage": "https://github.com/benchgen-ai/benchgen-openclaw#readme",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@langfuse/otel": "~5.14.0",
    "@langfuse/tracing": "~5.14.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/core": "~2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
    "@opentelemetry/otlp-exporter-base": "~0.223.0",
    "@opentelemetry/sdk-trace-base": "~2.12.0",
    "@opentelemetry/sdk-trace-node": "~2.12.0",
    "ws": "^8.18.0"
  }
}
